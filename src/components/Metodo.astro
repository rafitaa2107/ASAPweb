---
import { centroData } from '../data/centro';
import Icon from './Icon.astro';
---

<section class="w-full bg-surface-container-lowest py-space-xl" id="metodo">
  <div class="max-w-7xl mx-auto px-margin-mobile lg:px-margin">
    <div class="mb-space-xl pb-space-md border-b border-surface-variant flex flex-col md:flex-row md:items-end justify-between gap-space-md">
      <div>
        <span class="font-label-caps text-label-caps text-primary-container tracking-widest uppercase mb-space-xs block">
          03 / PROTOCOLO DE INCORPORACIÓN
        </span>
        <h2 class="font-headline-xl text-headline-xl uppercase text-on-surface leading-none">
          CÓMO FUNCIONA NUESTRO MÉTODO EN 3 PASOS
        </h2>
      </div>
      <p class="font-body-sm text-body-sm text-outline max-w-md leading-relaxed">
        Un sistema estructurado desde el minuto cero para que entrenes con seguridad, técnica perfecta y progresión asegurada.
      </p>
    </div>

    <!-- 3 Steps Grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-space-lg">
      {
        centroData.metodo.map((m) => (
          <div class="bg-surface-container p-space-xl flex flex-col justify-between border border-outline-variant/30 hover:border-primary-container/40 transition-colors relative">
            <div class="flex items-center justify-between mb-space-lg">
              <span class="font-index-numeral text-display-hero-mobile text-primary-container/80 leading-none">
                {m.numero}
              </span>
              <div class="w-8 h-8 rounded-full bg-surface-container-high flex items-center justify-center text-outline">
                <Icon name="check" size={16} />
              </div>
            </div>

            <div>
              <h3 class="font-headline-lg text-headline-lg uppercase text-on-surface mb-space-xs leading-snug">
                {m.titulo}
              </h3>
              <p class="font-body-sm text-body-sm text-on-surface-variant mb-space-md leading-relaxed">
                {m.descripcion}
              </p>
            </div>

            <div class="pt-space-sm border-t border-surface-variant text-outline font-label-caps text-[11px] uppercase tracking-wider">
              {m.detalle}
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
