---
interface Props {
  name:
    | 'call'
    | 'chat'
    | 'whatsapp'
    | 'verified'
    | 'star'
    | 'expand_more'
    | 'arrow_forward'
    | 'location_on'
    | 'check'
    | 'schedule'
    | 'person'
    | 'send'
    | 'directions'
    | 'fitness_center'
    | 'shield';
  class?: string;
  size?: number | string;
}

const { name, class: className = '', size = 20 } = Astro.props;
