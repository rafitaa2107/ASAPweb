---
import { centroData } from '../data/centro';
import LiveStatusBadge from './LiveStatusBadge.astro';
import Icon from './Icon.astro';
---

<section class="relative w-full bg-surface-container-lowest -mt-20 pt-28 pb-space-xl overflow-hidden" id="hero">
  <!-- Subtle mechanical line overlay pattern -->
  <div class="absolute inset-0 pointer-events-none opacity-[0.03] bg-[linear-gradient(to_right,#ffffff_1px,transparent_1px),linear-gradient(to_bottom,#ffffff_1px,transparent_1px)] bg-[size:3rem_3rem]"></div>

  <div class="max-w-7xl mx-auto px-margin-mobile lg:px-margin pt-space-md lg:pt-space-xl relative z-10">
    <!-- Top Meta Badges: Status + Google Rating + Location -->
    <div class="flex flex-wrap items-center gap-space-sm mb-space-md">
      <!-- Live Operating State Reactive Badge -->
      <LiveStatusBadge />

      <!-- Google Maps Rating Pill -->
      <a
        href="#opiniones"
        class="inline-flex items-center gap-space-xs px-space-sm py-space-xs bg-surface-container text-on-surface hover:bg-surface-container-high transition-colors border border-outline-variant/30"
      >
        <Icon name="star" class="text-primary-container" size={16} />
        <span class="font-title-technical text-body-sm text-on-surface">{centroData.rating.puntuacion.toFixed(1)} ★</span>
        <span class="font-label-caps text-label-caps tracking-wider uppercase text-outline">
          BASADAS EN {centroData.rating.totalResenas}+ RESEÑAS EN GOOGLE
        </span>
      </a>

      <!-- Location pill -->
      <div class="hidden sm:inline-flex items-center gap-space-xs px-space-sm py-space-xs bg-surface-container text-outline border border-outline-variant/30">
        <Icon name="location_on" class="text-secondary" size={16} />
        <span class="font-label-caps text-label-caps uppercase tracking-wider">{centroData.direccion.barrio}, Granada</span>
      </div>
    </div>

    <!-- Main Headline with Industrial Mass -->
    <div class="max-w-5xl mb-space-lg">
      <h1 class="font-display-hero-mobile lg:font-display-hero text-display-hero-mobile lg:text-display-hero uppercase text-on-surface tracking-tight leading-[0.95] mb-space-md">
        ENTRENAMIENTO DE FUERZA Y RENDIMIENTO EN EL ZAIDÍN
        <span class="text-primary-container block sm:inline"> SIN MASIFICACIONES</span>
      </h1>
      <p class="font-body-lg text-body-lg text-on-surface-variant max-w-3xl leading-relaxed">
        Grupos reducidos de máximo 10 atletas, programación técnica por bloques, readaptación deportiva y lesiones. El centro de entrenamiento que necesitas donde entrenas con técnica, criterio y resultados reales.
      </p>
    </div>

    <!-- Action Row: WhatsApp Primary + Call Secondary -->
    <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-space-md mb-space-xl">
      <a
        class="inline-flex items-center justify-center gap-space-sm px-space-lg py-space-md bg-primary-container hover:bg-inverse-primary text-on-primary font-headline-md text-headline-md uppercase tracking-wider transition-colors shadow-sm"
        href={`https://wa.me/${centroData.whatsapp}?text=${encodeURIComponent('¡Hola ASAP Training Center! Deseo reservar mi valoración técnica previa.')}`}
        target="_blank"
        rel="noopener noreferrer"
      >
        <Icon name="whatsapp" class="text-on-primary" size={24} />
        <span>RESERVAR VALORACIÓN POR WHATSAPP</span>
      </a>

      <a
        class="inline-flex items-center justify-center gap-space-sm px-space-lg py-space-md bg-surface-container hover:bg-surface-container-high text-on-surface font-headline-md text-headline-md uppercase tracking-wider transition-colors border border-outline-variant"
        href={`tel:${centroData.telefono}`}
      >
        <Icon name="call" class="text-secondary" size={22} />
        <span>LLAMAR AHORA: {centroData.telefonoFormateado}</span>
      </a>

      <div class="sm:ml-auto flex items-center gap-space-xs text-outline font-label-caps text-label-caps uppercase tracking-wider">
        <Icon name="verified" class="text-secondary" size={18} />
        <span>VALORACIÓN TÉCNICA PREVIA INCLUIDA</span>
      </div>
    </div>

    <!-- Hero Visual Panorámica Box Documental -->
    <div class="relative w-full aspect-[21/9] min-h-[360px] bg-surface-container overflow-hidden border border-surface-variant">
      <img
        class="w-full h-full object-cover grayscale-[15%] brightness-95"
        src="/fotos/hero-box.webp"
        alt="Fotografía de ASAP Training Center en el Zaidín, Granada. Instalaciones de entrenamiento funcional con suelo de caucho, jaulas de potencia y barras olímpicas."
        width="1280"
        height="548"
        loading="eager"
        fetchpriority="high"
        decoding="async"
      />

      <!-- Live technical telemetry overlay bottom bar -->
      <div class="absolute bottom-0 inset-x-0 bg-surface-container-lowest/90 backdrop-blur-md px-space-md py-space-sm flex flex-wrap items-center justify-between gap-space-sm border-t border-surface-variant/40">
        <div class="flex items-center gap-space-md">
          <span class="font-label-caps text-label-caps text-primary-container tracking-widest uppercase">INSTALACIONES</span>
          <span class="hidden sm:inline font-body-sm text-body-sm text-on-surface">Bancos · Poleas · Racks · Zona Mancuernas · Pista Trineo</span>
        </div>
        <div class="flex items-center gap-space-sm">
          <span class="w-2 h-2 rounded-full bg-secondary animate-pulse"></span>
          <span class="font-label-caps text-label-caps text-outline uppercase tracking-wider">Aforo Restringido · Máx 10</span>
        </div>
      </div>
    </div>
  </div>
</section>
